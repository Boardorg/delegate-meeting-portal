SALESFORCE_CLIENT_ID=your_connected_app_client_id
SALESFORCE_CLIENT_SECRET=your_connected_app_client_secret
SALESFORCE_BASE_URL=https://your-instance.salesforce.com
API_KEY=0123456789abcdefg

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Secret used to sign the login session JWT stored in the `session` cookie.
# Generate with: `openssl rand -base64 32`
SESSION_SECRET=your_session_secret

# Neon Postgres connection string (from the Neon console, "Pooled connection"
# is fine). Drizzle reads this via lib/db/client.ts and drizzle-kit reads it
# via drizzle.config.ts for migrations.
DATABASE_URL=postgres://user:pass@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Disable frontend login flow and checks, only use for development.
NEXT_PUBLIC_DISABLE_LOGIN_AUTHENTICATION=false

# Sponsor catalog data source.
# Set to "true" to load from data/mock/attendees.json instead of Salesforce.
USE_MOCK=true

# Force to a single Salesforce event code (e.g. BMWS). 
# You don't need to provide a code in the login url with this.
SF_EVENT_CODE=

# Cvent Appointments API — source of appointment locations and available times
# for the scheduling engine (lib/cvent/client.ts via @cvent/sdk). Ignored when
# USE_MOCK=true, in which case canned fixtures from data/mock/cvent/ are returned
# instead. Credentials come from the Cvent developer portal (OAuth2 client
# credentials): https://developers.cvent.com/docs/rest-api/overview
CVENT_CLIENT_ID=your_cvent_client_id
CVENT_CLIENT_SECRET=your_cvent_client_secret
# Optional — OAuth2 token endpoint. Defaults to Cvent production
# (https://api-platform.cvent.com/ea/oauth2/token). Override for a sandbox.
# NOTE: leave unset (not just empty) — an empty-but-present value trips the
# @cvent/sdk credentials-completeness check and silently drops the
# Authorization header on every call.
# CVENT_TOKEN_URL=
# Optional — space- or comma-separated OAuth2 scopes. When omitted the SDK uses
# the per-operation scopes it declares for each endpoint.
CVENT_SCOPES=

# Set to "true" to suppress Cvent notifications (invite/update emails) when
# pushing appointments — useful while testing so real contacts aren't emailed.
# Defaults to sending notifications as configured in Cvent.
CVENT_SUPPRESS_NOTIFICATIONS=

# Set to "true" for non-prod / dry-run events. Testing mode:
#   - Treats Cvent attendee emails as obfuscated ("xx<email>xx", e.g.
#     "xxmary@site.comxx") and strips the wrapper before the Salesforce↔Cvent
#     email cross-check.
#   - Lets admins use the frontend portal (normally they're redirected to /admin),
#     standing in as the first mock attendee so they have a Salesforce id for
#     making meeting requests.
#   - Lets admins spoof salesforce pulled sponsors from available events.
TESTING_MODE=